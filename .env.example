# ==============================================================================
# ImpactLens - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudinary Media Ledger Configuration
# ------------------------------------------------------------------------------
# Obtain from your Cloudinary Console (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Client-accessible Cloudinary Cloud Name (for direct signed uploads in browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & pgvector Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings (Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Client-accessible Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Configuration
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
# Used for:
#   - Gemini 2.5 Flash Lite Vision (Image analysis, grounded object & activity detection)
#   - Gemini embedding-001 (768-dimensional pgvector semantic embeddings)
#   - Chronological Before/After visible change synthesis
GEMINI_API_KEY=your_gemini_api_key_here
